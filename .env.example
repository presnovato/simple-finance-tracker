# Telegram
BOT_TOKEN=1234567890:replace-with-bot-token
ALLOWED_USER_ID=123456789

# OpenRouter
# Не нужен для /manual и ручного ввода в TMA.
OPENROUTER_API_KEY=replace-with-openrouter-key
# 1 — исключать провайдеров, которые хранят данные или обучаются на них
LLM_DENY_DATA_COLLECTION=1

# Файл базы SQLite. На Railway — путь внутри подключённого Volume.
DB_PATH=/data/finance.db
# 1 — падать на старте, если каталог базы не существует (защита от эфемерного диска)
DB_REQUIRE_PERSISTENT_DIR=1

# Публичный HTTPS-домен Railway, с которого раздаётся Telegram Mini App
TMA_URL=https://your-service.up.railway.app
PORT=8080

# Опционально (значения по умолчанию)
TIMEZONE=Europe/Moscow
PRIMARY_MODEL=qwen/qwen2.5-vl-72b-instruct
FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Ежедневный автобэкап базы в чат владельца (1 — включён)
BACKUP_ENABLED=1
# Час запуска автобэкапа по TIMEZONE (0–23)
BACKUP_HOUR=4
